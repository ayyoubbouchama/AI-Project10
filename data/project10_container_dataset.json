  "algorithm_hints": {
    "greedy_bfd": {
      "strategy": "Best-Fit Decreasing",
      "sort_by": "volume_descending",
      "description": "Sort boxes by volume largest-first. Place each box at the first valid position (Deepest Bottom-Left Fill)."
    },
    "genetic_algorithm": {
      "chromosome": "permutation of all 386 box instances (by box_id repeated by quantity)",
      "decoder": "Apply DBLF heuristic to the permutation order",
      "fitness": "total volume packed / container volume",
      "mutation": "swap two random positions in the permutation",
      "crossover": "Order Crossover (OX1)"
    },
    "simulated_annealing": {
      "perturbation": "swap two box positions in the packing sequence",
      "objective": "maximize volume utilization",
      "initial_temperature": 1000,
      "cooling_rate": 0.995
    },
    "stability_rule": "Sort heavy boxes first (weight_kg descending) to place them at the bottom layer.",
    "fragile_rule": "orientation_locked=true boxes must never be rotated so their top face becomes a bottom face."
  }
